# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Extensionless Linux/macOS binary from `go build -o bridge-talk .` (root-anchored
# so it never matches a tracked asset of the same name)
/bridge-talk

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov
*.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
.claude/

# macOS filesystem junk
.DS_Store

# Node / frontend
node_modules/
frontend/dist/
# The npm lock file is not committed; an install resolves from package.json
frontend/package-lock.json
# Vitest coverage output
frontend/coverage/
# Wails npm dependency-hash cache (regenerated on every build)
frontend/package.json.md5
# Wails Go->JS bindings, regenerated by `wails build` on every run
frontend/wailsjs/
installer/frontend/wailsjs/

# Wails build output and scaffolding. Wails writes the whole directory back when it
# is absent, which a clean-tree build has been checked to prove; the scaffolding it
# writes carries only its own template placeholders. There is nothing to version
# here: the binary, the icons regenerated from the master PNG and the manifest are
# all outputs.
build/

frontend/src/assets/bridge-talk.png

# Windows setup-program build output. installer/payload.zip is tracked, but only as
# the 22-byte empty archive that keeps `go build ./...` working; build.ps1 puts that
# placeholder back after every build, so the real multi-megabyte payload never
# reaches a commit.
dist-installer/
installer/build/

# The files a machine voice is made from, filled by `go run ./tools/models` (FR-536)
/models/

# Local scratch
NOTES.md
*.db
*.db-*

# Stray root package-lock.json created when npm runs in repo root during wails generate module
/package-lock.json

# The Python venv used only for tools/genicons.py
venv/
__pycache__/
*.pyc
